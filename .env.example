# Public URL of the site, no trailing slash (e.g. https://utmalive.vercel.app).
# Must match the redirect registered in the Discord developer portal:
#   ${APP_URL}/api/auth/callback
# Leave empty on Vercel (the production URL is detected); use http://localhost:3000 locally.
APP_URL=

# 32+ random characters. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Discord application (https://discord.com/developers/applications -> OAuth2)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Your server. Only its members can log in.
DISCORD_GUILD_ID=
# Role that can go live. Right-click the role in Discord (developer mode on) -> Copy Role ID.
DISCORD_STREAMER_ROLE_ID=
# Optional: require this "verified" role to log in. Leave empty to allow every server member.
DISCORD_MEMBER_ROLE_ID=

# Discord invite shown on the login page (Server → Invite People → Edit link → Never expire)
DISCORD_INVITE_URL=
# Optional auto-role: a bot in your server with Manage Roles + Create Invite, its role
# dragged ABOVE the viewer role. Users get this role (and are added to the server) on login.
DISCORD_BOT_TOKEN=
DISCORD_VIEWER_ROLE_ID=

# Postgres (Neon via the Vercel Marketplace works out of the box)
DATABASE_URL=

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
# From the webhook endpoint pointing at ${APP_URL}/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# LiveKit (https://cloud.livekit.io -> your project -> Settings -> API Keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Default ticket price in euro cents
DEFAULT_PRICE_CENTS=200
